# Server & Environment
PORT=3000
NODE_ENV=development

# Cloud SQL / PostgreSQL (Optional: connect PostgreSQL database)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Firebase Project (Optional: configured in firebase-applet-config.json)
FIREBASE_PROJECT_ID=studied-gecko-gpthm
VITE_FIREBASE_PROJECT_ID=studied-gecko-gpthm

# Paystack Payment Gateway (Optional)
PAYSTACK_SECRET_KEY=
PAYSTACK_TOKEN_ENCRYPTION_KEY=
ALLOW_ADMIN_PLAN_OVERRIDE=false

# AI Studio development options
DISABLE_HMR=true
